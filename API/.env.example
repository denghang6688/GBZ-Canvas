# 把本文件复制为 .env 并填入你自己的值；.env 已在 .gitignore 内，不会被提交。

# ---- 主供应商（默认 APIMart 异步）----
APIMART_BASE_URL=https://api.apimart.ai
APIMART_API_KEY=

# ---- ModelScope（魔搭）----
MODELSCOPE_API_KEY=
# MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn

# ---- ComfyUI 本地实例（可选）----
# COMFYUI_BASE_URL=http://127.0.0.1:8188

# ---- RunningHub（云端 ComfyUI，可选）----
# RUNNINGHUB_API_KEY=
# RUNNINGHUB_WALLET_KEY=

# ---- 服务端口（默认 2000）----
GBZ_PORT=2000
